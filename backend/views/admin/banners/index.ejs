<div class="space-y-8">
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-black text-gray-900 uppercase tracking-tight">Bannerlar Boshqaruvi</h1>
        <button onclick="document.getElementById('add-banner-modal').classList.remove('hidden')" class="bg-primary text-white px-6 py-2.5 rounded-xl font-bold text-sm uppercase tracking-wider hover:opacity-90 transition-all flex items-center">
            <i class="fas fa-plus mr-2"></i> Yangi banner
        </button>
    </div>

    <!-- Banner List -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% banners.forEach(banner => { %>
            <div class="bg-white rounded-3xl overflow-hidden shadow-xl border border-gray-100 group">
                <div class="relative h-48 overflow-hidden">
                    <img src="<%= banner.image %>" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <form action="/admin/banners/<%= banner.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Rostdan ham o\'chirmoqchimisiz?')">
                            <button class="w-12 h-12 bg-red-500 text-white rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                    <div class="absolute top-4 left-4">
                        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest <%= banner.active ? 'bg-green-500' : 'bg-gray-500' %> text-white shadow-lg">
                            <%= banner.active ? 'Faol' : 'Nofaol' %>
                        </span>
                    </div>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <h3 class="font-bold text-gray-900 line-clamp-1"><%= banner.title.uz %></h3>
                        <p class="text-xs text-gray-500 line-clamp-1"><%= banner.subtitle.uz %></p>
                    </div>
                    <div class="flex items-center justify-between pt-4 border-t border-gray-50">
                        <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Tartib: <%= banner.order %></span>
                        <form action="/admin/banners/<%= banner.id %>/toggle?_method=PUT" method="POST">
                            <button class="text-[10px] font-black uppercase tracking-widest <%= banner.active ? 'text-red-500 hover:text-red-600' : 'text-green-500 hover:text-green-600' %>">
                                <%= banner.active ? 'O\'chirish' : 'Yoqish' %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Add Banner Modal -->
    <div id="add-banner-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-[40px] w-full max-w-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-300">
            <div class="p-8 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                <h2 class="text-xl font-black text-gray-900 uppercase tracking-tight">Yangi banner qo'shish</h2>
                <button onclick="document.getElementById('add-banner-modal').classList.add('hidden')" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-200 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <form action="/admin/banners" method="POST" class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (UZ)</label>
                        <input type="text" name="title_uz" required class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (RU)</label>
                        <input type="text" name="title_ru" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (EN)</label>
                        <input type="text" name="title_en" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium">
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sub-Sarlavha (UZ)</label>
                        <textarea name="subtitle_uz" rows="2" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium"></textarea>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sub-Sarlavha (RU)</label>
                        <textarea name="subtitle_ru" rows="2" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium"></textarea>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sub-Sarlavha (EN)</label>
                        <textarea name="subtitle_en" rows="2" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium"></textarea>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Rasm URL</label>
                        <input type="url" name="image" required class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium" placeholder="https://example.com/image.jpg">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Ko'rsatish tartibi</label>
                        <input type="number" name="order" value="0" class="w-full px-5 py-4 bg-gray-50 border border-transparent focus:border-primary focus:bg-white rounded-2xl transition-all outline-none text-sm font-medium">
                    </div>
                </div>
                <div class="pt-4">
                    <button type="submit" class="w-full bg-primary text-white py-5 rounded-2xl font-black text-sm uppercase tracking-[0.2em] shadow-xl hover:opacity-90 transition-all">Saqlash</button>
                </div>
            </form>
        </div>
    </div>
</div>
