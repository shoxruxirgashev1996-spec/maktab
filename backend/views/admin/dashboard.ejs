<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 flex flex-col space-y-6 group hover:shadow-xl transition-all duration-500">
        <div class="w-16 h-16 rounded-[24px] bg-blue-50 text-blue-600 flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-all shadow-sm">
            <i class="fas fa-file-signature"></i>
        </div>
        <div>
            <div class="text-4xl font-black text-gray-900 mb-1 tracking-tight"><%= stats.applications %></div>
            <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Jami arizalar</div>
        </div>
        <% if (stats.pendingApps > 0) { %>
            <div class="pt-4 border-t border-gray-50">
                <span class="text-[10px] font-black text-red-500 uppercase tracking-widest flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <%= stats.pendingApps %> ta yangi
                </span>
            </div>
        <% } %>
    </div>

    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 flex flex-col space-y-6 group hover:shadow-xl transition-all duration-500">
        <div class="w-16 h-16 rounded-[24px] bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-sm">
            <i class="fas fa-newspaper"></i>
        </div>
        <div>
            <div class="text-4xl font-black text-gray-900 mb-1 tracking-tight"><%= stats.news %></div>
            <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Yangiliklar</div>
        </div>
    </div>

    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 flex flex-col space-y-6 group hover:shadow-xl transition-all duration-500">
        <div class="w-16 h-16 rounded-[24px] bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl group-hover:bg-emerald-600 group-hover:text-white transition-all shadow-sm">
            <i class="fas fa-envelope"></i>
        </div>
        <div>
            <div class="text-4xl font-black text-gray-900 mb-1 tracking-tight"><%= stats.messages %></div>
            <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Xabarlar</div>
        </div>
    </div>

    <div class="bg-white p-8 rounded-[40px] shadow-sm border border-gray-100 flex flex-col space-y-6 group hover:shadow-xl transition-all duration-500">
        <div class="w-16 h-16 rounded-[24px] bg-amber-50 text-amber-600 flex items-center justify-center text-2xl group-hover:bg-amber-600 group-hover:text-white transition-all shadow-sm">
            <i class="fas fa-user-shield"></i>
        </div>
        <div>
            <div class="text-[20px] font-black text-gray-900 mb-1 uppercase tracking-tighter"><%= admin.role %></div>
            <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none">Sizning rolingiz</div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    <!-- Quick Actions -->
    <div class="bg-white rounded-[40px] shadow-sm border border-gray-100 p-10">
        <h3 class="text-xl font-black text-gray-900 mb-10 uppercase tracking-tight">Tezkor amallar</h3>
        <div class="grid grid-cols-2 gap-6">
            <a href="/admin/news/create" class="flex flex-col items-center justify-center p-8 bg-blue-50 rounded-[32px] hover:bg-blue-600 hover:text-white transition-all group text-blue-600">
                <i class="fas fa-plus-circle text-2xl mb-4 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Yangilik qo'shish</span>
            </a>
            <a href="/admin/applications" class="flex flex-col items-center justify-center p-8 bg-indigo-50 rounded-[32px] hover:bg-indigo-600 hover:text-white transition-all group text-indigo-600">
                <i class="fas fa-clipboard-list text-2xl mb-4 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Arizalarni ko'rish</span>
            </a>
            <a href="/admin/settings" class="flex flex-col items-center justify-center p-8 bg-amber-50 rounded-[32px] hover:bg-amber-600 hover:text-white transition-all group text-amber-600">
                <i class="fas fa-tools text-2xl mb-4 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Sozlamalar</span>
            </a>
            <a href="/" target="_blank" class="flex flex-col items-center justify-center p-8 bg-emerald-50 rounded-[32px] hover:bg-emerald-600 hover:text-white transition-all group text-emerald-600">
                <i class="fas fa-external-link-alt text-2xl mb-4 group-hover:scale-110 transition-transform"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Saytga o'tish</span>
            </a>
        </div>
    </div>

    <!-- Active Language -->
    <div class="bg-white rounded-[40px] shadow-sm border border-gray-100 p-10 flex flex-col justify-center items-center text-center space-y-6">
        <div class="w-24 h-24 rounded-full bg-blue-600 flex items-center justify-center text-white text-3xl font-black shadow-2xl animate-pulse">
            <%= lang.toUpperCase() %>
        </div>
        <div>
            <h4 class="text-xl font-black text-gray-900 uppercase mb-2">Tizim tili</h4>
            <p class="text-gray-400 font-medium text-sm leading-relaxed px-10">Hozirda sayt <%= lang.toUpperCase() %> tilida ishlamoqda. Admin paneli ham shunga moslanadi.</p>
        </div>
    </div>
</div>
