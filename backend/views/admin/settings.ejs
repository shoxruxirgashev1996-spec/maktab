<div class="space-y-8">
    <div class="flex justify-between items-center">
        <h2 class="text-3xl font-black text-gray-900 tracking-tight uppercase">Tizim sozlamalari</h2>
    </div>

    <div class="bg-white rounded-[32px] shadow-sm border border-gray-100 overflow-hidden">
        <form action="/admin/settings" method="POST" class="p-8 space-y-10">
            <!-- Branding -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-fingerprint"></i>
                    <span>Brending va Identitet</span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sayt nomi</label>
                        <input type="text" name="siteName" value="<%= settings.siteName %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Logo URL</label>
                        <input type="text" name="logo" value="<%= settings.logo %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                </div>
            </section>

            <!-- Banner Content -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-image"></i>
                    <span>Asosiy Banner (Hero)</span>
                </h3>
                <div class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Sarlavhasi (UZ)</label>
                            <input type="text" name="bannerTitle_uz" value="<%= settings.bannerTitle.uz %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Sarlavhasi (RU)</label>
                            <input type="text" name="bannerTitle_ru" value="<%= settings.bannerTitle.ru %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Sarlavhasi (EN)</label>
                            <input type="text" name="bannerTitle_en" value="<%= settings.bannerTitle.en %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Subtitr (UZ)</label>
                            <textarea name="bannerSubtitle_uz" rows="3" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"><%= settings.bannerSubtitle.uz %></textarea>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Subtitr (RU)</label>
                            <textarea name="bannerSubtitle_ru" rows="3" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"><%= settings.bannerSubtitle.ru %></textarea>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Subtitr (EN)</label>
                            <textarea name="bannerSubtitle_en" rows="3" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"><%= settings.bannerSubtitle.en %></textarea>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Banner Rasmi (URL)</label>
                        <input type="text" name="bannerImage" value="<%= settings.bannerImage %>" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                </div>
            </section>

            <!-- Colors -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-palette"></i>
                    <span>Ranglar palitrasi</span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Asosiy rang (Primary)</label>
                        <div class="flex space-x-4">
                            <input type="color" name="primaryColor" value="<%= settings.primaryColor %>" class="h-14 w-20 p-1 bg-white border border-gray-100 rounded-xl cursor-pointer">
                            <input type="text" value="<%= settings.primaryColor %>" class="flex-grow px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl outline-none font-mono text-sm" readonly>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Yordamchi rang (Secondary)</label>
                        <div class="flex space-x-4">
                            <input type="color" name="secondaryColor" value="<%= settings.secondaryColor %>" class="h-14 w-20 p-1 bg-white border border-gray-100 rounded-xl cursor-pointer">
                            <input type="text" value="<%= settings.secondaryColor %>" class="flex-grow px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl outline-none font-mono text-sm" readonly>
                        </div>
                    </div>
                </div>
            </section>

            <div class="pt-10 border-t border-gray-50">
                <button type="submit" class="w-full md:w-auto px-12 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-black text-xs uppercase tracking-widest transition-all shadow-xl shadow-blue-900/20">
                    O'zgarishlarni saqlash
                </button>
            </div>
        </form>
    </div>
</div>
