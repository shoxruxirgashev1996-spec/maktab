                </a>
                <a href="/gallery" class="flex items-center justify-between p-6 bg-[#001529] text-white rounded-[24px] hover:bg-primary transition-all transform hover:-translate-y-1 shadow-xl hover:shadow-blue-900/30 group">
                    <div class="flex items-center space-x-5">
                        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center group-hover:bg-blue-400 group-hover:text-white transition-colors">
                            <i class="fas fa-images text-xl"></i>
                        </div>
                        <span class="text-sm font-black uppercase tracking-widest"><%= lang === 'uz' ? 'Maktab Galereyasi' : (lang === 'ru' ? 'Галерея школы' : 'School Gallery') %></span>
                    </div>
                    <i class="fas fa-arrow-right opacity-30 group-hover:opacity-100 transform group-hover:translate-x-1 transition-all"></i>
                </a>
            </div>
        </div>
    </div>
</section>
