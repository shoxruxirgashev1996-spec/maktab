                    <div class="flex items-center space-x-5">
                        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center group-hover:bg-yellow-400 group-hover:text-[#003366] transition-colors">
                            <i class="fas fa-file-signature text-xl"></i>
                        </div>
                        <span class="text-sm font-black uppercase tracking-widest"><%= lang === 'uz' ? 'Onlayn Qabul' : (lang === 'ru' ? 'Онлайн прием' : 'Online Admission') %></span>
                    </div>
                    <i class="fas fa-arrow-right opacity-30 group-hover:opacity-100 transform group-hover:translate-x-1 transition-all"></i>
                </a>
                <a href="/budget" class="flex items-center justify-between p-6 bg-[#001529] text-white rounded-[24px] hover:bg-primary transition-all transform hover:-translate-y-1 shadow-xl hover:shadow-blue-900/30 group">
                    <div class="flex items-center space-x-5">
                        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center group-hover:bg-emerald-400 group-hover:text-[#001529] transition-colors">
                            <i class="fas fa-chart-pie text-xl"></i>
                        </div>
