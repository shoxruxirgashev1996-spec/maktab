<!-- Hero Section -->
<section id="hero-carousel" class="relative h-[85vh] flex items-center overflow-hidden bg-[#003366]">
    <% if (banners && banners.length > 0) { %>
        <% banners.forEach((banner, index) => { %>
            <div class="carousel-item absolute inset-0 transition-opacity duration-1000 <%= index === 0 ? 'opacity-100' : 'opacity-0' %>" data-index="<%= index %>">
                <div class="absolute inset-0 z-0">
                    <img src="<%= banner.image %>" class="w-full h-full object-cover brightness-[0.4]" alt="Banner <%= index + 1 %>">
                    <div class="absolute inset-0 bg-gradient-to-r from-primary/60 to-transparent"></div>
                </div>
                <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
                    <div class="max-w-4xl text-white space-y-10">
                        <div class="space-y-6">
                            <div class="inline-block px-4 py-1.5 bg-blue-600/30 backdrop-blur-md rounded-full border border-blue-400/30 text-[10px] sm:text-xs font-black uppercase tracking-[0.3em]">
                                <%= settings.siteName %>
                            </div>
                            <h1 class="text-5xl sm:text-7xl xl:text-8xl font-black leading-[1.05] tracking-tighter uppercase">
                                <%= banner.title[lang] %>
                            </h1>
                        </div>
                        <p class="text-lg md:text-2xl text-blue-100 leading-relaxed font-medium max-w-2xl">
                            <%= banner.subtitle[lang] %>
                        </p>
                        <div class="flex flex-wrap gap-6 pt-4">
                            <a href="/admission" class="bg-yellow-400 hover:bg-yellow-500 text-primary px-10 py-5 rounded-full font-black text-xs sm:text-sm uppercase tracking-widest flex items-center shadow-2xl transform hover:-translate-y-1 transition-all">
                                <%= t('apply') %> <i class="fas fa-arrow-right ml-3 text-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>

        <% if (banners.length > 1) { %>
            <!-- Carousel Dots -->
            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex space-x-3">
                <% banners.forEach((_, index) => { %>
                    <button class="carousel-dot w-3 h-3 rounded-full border-2 border-white/50 transition-all <%= index === 0 ? 'bg-white w-8' : '' %>" data-index="<%= index %>"></button>
                <% }) %>
            </div>
            
            <!-- Scripts for Carousel -->
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const items = document.querySelectorAll('.carousel-item');
                    const dots = document.querySelectorAll('.carousel-dot');
                    let currentIndex = 0;
                    const interval = 30000; // 30 seconds

                    function showBanner(index) {
                        items.forEach(item => {
                            item.classList.add('opacity-0');
                            item.classList.remove('opacity-100');
                        });
                        dots.forEach(dot => {
                            dot.classList.remove('bg-white', 'w-8');
                        });

                        items[index].classList.remove('opacity-0');
                        items[index].classList.add('opacity-100');
                        dots[index].classList.add('bg-white', 'w-8');
                        currentIndex = index;
                    }

                    function nextBanner() {
                        let next = (currentIndex + 1) % items.length;
                        showBanner(next);
                    }

                    let slideInterval = setInterval(nextBanner, interval);

                    dots.forEach(dot => {
                        dot.addEventListener('click', () => {
                            clearInterval(slideInterval);
                            showBanner(parseInt(dot.dataset.index));
                            slideInterval = setInterval(nextBanner, interval);
                        });
                    });
                });
            </script>
        <% } %>
    <% } else { %>
        <!-- Fallback if no banners are added -->
        <div class="absolute inset-0 z-0">
            <img src="<%= settings.bannerImage %>" class="w-full h-full object-cover brightness-[0.4]" alt="School">
            <div class="absolute inset-0 bg-gradient-to-r from-primary/60 to-transparent"></div>
        </div>
        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
            <div class="max-w-4xl text-white space-y-10">
                <div class="space-y-6">
                    <div class="inline-block px-4 py-1.5 bg-blue-600/30 backdrop-blur-md rounded-full border border-blue-400/30 text-[10px] sm:text-xs font-black uppercase tracking-[0.3em]">
                        <%= settings.siteName %>
                    </div>
                    <h1 class="text-5xl sm:text-7xl xl:text-8xl font-black leading-[1.05] tracking-tighter uppercase">
                        <%= settings.bannerTitle[lang] %>
                    </h1>
                </div>
                <p class="text-lg md:text-2xl text-blue-100 leading-relaxed font-medium max-w-2xl">
                    <%= settings.bannerSubtitle[lang] %>
                </p>
                <div class="flex flex-wrap gap-6 pt-4">
                    <a href="/admission" class="bg-yellow-400 hover:bg-yellow-500 text-primary px-10 py-5 rounded-full font-black text-xs sm:text-sm uppercase tracking-widest flex items-center shadow-2xl transform hover:-translate-y-1 transition-all">
                        <%= t('apply') %> <i class="fas fa-arrow-right ml-3 text-lg"></i>
                    </a>
                </div>
            </div>
        </div>
    <% } %>
</section>

<!-- Stats Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 lg:-mt-32 relative z-20 mb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8">
        <div class="bg-white p-6 lg:p-10 rounded-[40px] shadow-2xl shadow-blue-900/5 border border-gray-100 flex flex-col items-center text-center space-y-4 hover:-translate-y-2 transition-transform duration-500 overflow-hidden relative group">
            <div class="p-5 rounded-3xl bg-blue-50 text-blue-600 relative z-10">
                <i class="fas fa-users text-3xl"></i>
            </div>
            <div class="relative z-10">
                <div class="text-4xl font-black text-gray-900 mb-1"><%= stats.students %>+</div>
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]"><%= lang === 'uz' ? 'O\'quvchilar' : (lang === 'ru' ? 'Ученики' : 'Students') %></div>
            </div>
        </div>
        <div class="bg-white p-6 lg:p-10 rounded-[40px] shadow-2xl shadow-blue-900/5 border border-gray-100 flex flex-col items-center text-center space-y-4 hover:-translate-y-2 transition-transform duration-500 overflow-hidden relative group">
            <div class="p-5 rounded-3xl bg-indigo-50 text-indigo-600 relative z-10">
                <i class="fas fa-user-graduate text-3xl"></i>
            </div>
            <div class="relative z-10">
                <div class="text-4xl font-black text-gray-900 mb-1"><%= stats.teachers %>+</div>
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]"><%= lang === 'uz' ? 'Ustozlar' : (lang === 'ru' ? 'Учителя' : 'Teachers') %></div>
            </div>
        </div>
        <div class="bg-white p-6 lg:p-10 rounded-[40px] shadow-2xl shadow-blue-900/5 border border-gray-100 flex flex-col items-center text-center space-y-4 hover:-translate-y-2 transition-transform duration-500 overflow-hidden relative group">
            <div class="p-5 rounded-3xl bg-yellow-50 text-yellow-600 relative z-10">
                <i class="fas fa-award text-3xl"></i>
            </div>
            <div class="relative z-10">
                <div class="text-4xl font-black text-gray-900 mb-1"><%= stats.achievements %>+</div>
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]"><%= lang === 'uz' ? 'Yutuqlar' : (lang === 'ru' ? 'Достижения' : 'Achievements') %></div>
            </div>
        </div>
        <div class="bg-white p-6 lg:p-10 rounded-[40px] shadow-2xl shadow-blue-900/5 border border-gray-100 flex flex-col items-center text-center space-y-4 hover:-translate-y-2 transition-transform duration-500 overflow-hidden relative group">
            <div class="p-5 rounded-3xl bg-emerald-50 text-emerald-600 relative z-10">
                <i class="fas fa-laptop-code text-3xl"></i>
            </div>
            <div class="relative z-10">
                <div class="text-4xl font-black text-gray-900 mb-1"><%= stats.clubs %>+</div>
                <div class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]"><%= lang === 'uz' ? 'To\'garaklar' : (lang === 'ru' ? 'Кружки' : 'Clubs') %></div>
            </div>
        </div>
    </div>
</section>

<!-- News Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
    <div class="flex justify-between items-end mb-12">
        <div class="space-y-1">
            <h2 class="text-xs font-black text-primary uppercase tracking-[0.3em]"><%= t('news') %></h2>
            <h3 class="text-3xl sm:text-4xl font-black text-gray-900 uppercase"><%= lang === 'uz' ? 'So\'nggi yangiliklar' : (lang === 'ru' ? 'Последние новости' : 'Latest News') %></h3>
        </div>
        <a href="/news" class="text-xs font-black text-primary uppercase tracking-[0.1em] flex items-center hover:opacity-70 transition-opacity border-b-2 border-transparent hover:border-primary pb-1">
            <%= lang === 'uz' ? 'Barchasi' : (lang === 'ru' ? 'Все' : 'All') %> <i class="fas fa-arrow-right ml-2 text-sm"></i>
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% news.forEach(item => { %>
            <div class="group bg-white rounded-3xl overflow-hidden shadow-xl shadow-blue-900/5 border border-gray-100 hover:shadow-2xl transition-all duration-500 flex flex-col h-full transform hover:-translate-y-2">
                <div class="relative h-64 overflow-hidden">
                    <img src="<%= item.image %>" alt="<%= item.title[lang] %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                    <div class="absolute top-0 left-0 bg-primary text-white px-5 py-3 rounded-br-3xl flex flex-col items-center justify-center shadow-lg z-10">
                        <span class="text-lg font-black leading-none"><%= new Date(item.date).getDate() %></span>
                        <span class="text-[10px] font-bold uppercase tracking-widest mt-1 opacity-80">
                            <%= new Date(item.date).toLocaleString(lang, { month: 'short' }) %>
                        </span>
                    </div>
                </div>
                <div class="p-8 flex flex-col flex-grow">
                    <h3 class="text-xl font-bold text-gray-900 mb-4 line-clamp-2 group-hover:text-primary transition-colors leading-tight uppercase tracking-tight">
                        <%= item.title[lang] %>
                    </h3>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6 line-clamp-3">
                        <%= item.content[lang].substring(0, 150) %>...
                    </p>
                    <div class="mt-auto pt-6 border-t border-gray-50 flex justify-between items-center">
                        <a href="/news/<%= item.id %>" class="text-xs font-black text-primary uppercase tracking-[0.2em] flex items-center group/btn">
                            <%= t('read_more') %> <i class="fas fa-chevron-right ml-2 transform group-hover/btn:translate-x-1 transition-transform"></i>
                        </a>
                        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= item.category %></span>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<!-- Announcements & Quick Links -->
<section class="bg-white py-24 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Announcements -->
        <div class="lg:col-span-7">
            <div class="flex justify-between items-end mb-10">
                <h3 class="text-2xl font-black text-primary uppercase tracking-tight"><%= lang === 'uz' ? 'E\'lonlar' : (lang === 'ru' ? 'Объявления' : 'Announcements') %></h3>
                <a href="/news" class="text-xs font-bold text-gray-400 hover:text-primary flex items-center uppercase tracking-widest transition-colors">
                    <%= lang === 'uz' ? 'Barchasi' : (lang === 'ru' ? 'Все' : 'All') %> <i class="fas fa-arrow-right ml-2 text-xs"></i>
                </a>
            </div>
            <div class="space-y-4">
                <% announcements.forEach(e => { %>
                    <div class="flex items-start space-x-5 p-6 rounded-[32px] hover:bg-gray-50 transition-all border border-transparent hover:border-gray-100 group">
                        <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center text-gray-400 group-hover:bg-primary group-hover:text-white transition-all shadow-sm shrink-0">
                            <i class="fas fa-bell text-2xl"></i>
                        </div>
                        <div class="flex-grow space-y-2 pt-1">
                            <div class="flex justify-between items-start">
                                <h4 class="font-black text-gray-900 uppercase text-sm group-hover:text-primary transition-colors tracking-tight"><%= e.title[lang] %></h4>
                                <span class="text-[10px] font-black text-gray-400 uppercase bg-gray-100 px-3 py-1.5 rounded-xl"><%= e.date.toLocaleDateString() %></span>
                            </div>
                            <p class="text-sm text-gray-500 leading-relaxed line-clamp-2"><%= e.content[lang] %></p>
                        </div>
