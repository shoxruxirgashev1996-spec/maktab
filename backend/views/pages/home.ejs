        </div>

        <!-- Quick Links -->
        <div class="lg:col-span-5">
            <div class="flex justify-between items-end mb-10">
                <h3 class="text-2xl font-black text-primary uppercase tracking-tight"><%= lang === 'uz' ? 'Tezkor havolalar' : (lang === 'ru' ? 'Быстрые ссылки' : 'Quick Links') %></h3>
