<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Kirish | Ixtisoslashtirilgan Maktab</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-[#003366] min-h-screen flex items-center justify-center p-4">
    
    <div class="max-w-md w-full">
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-white rounded-2xl mx-auto flex items-center justify-center shadow-2xl mb-6">
                <i class="fas fa-user-shield text-[#003366] text-4xl"></i>
            </div>
            <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Admin Panel</h1>
            <p class="text-blue-200 text-sm font-bold mt-2 uppercase tracking-widest">Tizimga kirish</p>
        </div>

        <div class="bg-white rounded-[32px] p-8 shadow-2xl">
            <% if (error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-xl">
                    <p class="text-red-700 font-bold text-sm"><%= error %></p>
                </div>
            <% } %>

            <form action="/admin/login" method="POST" class="space-y-6">
                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1"><%= t('username') %></label>
                    <div class="relative">
                        <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="username" required class="w-full pl-12 pr-4 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-bold text-gray-900" placeholder="admin">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2 ml-1"><%= t('password') %></label>
                    <div class="relative">
                        <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="password" name="password" required class="w-full pl-12 pr-4 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-600 transition-all font-bold text-gray-900" placeholder="••••••••">
                    </div>
                </div>

                <button type="submit" class="w-full py-4 bg-[#003366] text-white rounded-2xl font-black uppercase tracking-[0.2em] shadow-xl hover:bg-blue-800 transition-all transform hover:-translate-y-1 active:scale-95">
                    <%= t('login') %> <i class="fas fa-sign-in-alt ml-2"></i>
                </button>
            </form>
            
            <div class="mt-8 pt-8 border-t border-gray-50 text-center">
                <a href="/" class="text-xs font-bold text-gray-400 hover:text-[#003366] uppercase tracking-widest inline-flex items-center">
                    <i class="fas fa-arrow-left mr-2"></i> <%= t('home') %>
                </a>
            </div>
        </div>
    </div>

</body>
</html>
