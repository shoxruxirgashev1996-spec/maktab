<div class="space-y-8">
    <div class="flex justify-between items-center">
        <h2 class="text-3xl font-black text-gray-900 tracking-tight uppercase">Yangi yangilik qo'shish</h2>
        <a href="/admin/news" class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl font-bold text-xs uppercase tracking-widest transition-all">
            <i class="fas fa-arrow-left mr-2"></i> Orqaga qaytish
        </a>
    </div>

    <div class="bg-white rounded-[32px] shadow-sm border border-gray-100 overflow-hidden">
        <form action="/admin/news" method="POST" class="p-8 space-y-10">
            <!-- Title -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-heading"></i>
                    <span>Sarlavhalar (3 tilda)</span>
                </h3>
                <div class="space-y-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (O'zbekcha)</label>
                        <input type="text" name="title_uz" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (Ruscha)</label>
                        <input type="text" name="title_ru" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Sarlavha (Inglizcha)</label>
                        <input type="text" name="title_en" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                    </div>
                </div>
            </section>

            <!-- Content -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-align-left"></i>
                    <span>Matn mazmuni (3 tilda)</span>
                </h3>
                <div class="grid grid-cols-1 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Matn (O'zbekcha)</label>
                        <textarea name="content_uz" rows="5" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"></textarea>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Matn (Ruscha)</label>
                        <textarea name="content_ru" rows="5" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"></textarea>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Matn (Inglizcha)</label>
                        <textarea name="content_en" rows="5" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium"></textarea>
                    </div>
                </div>
            </section>

            <!-- Details -->
            <section class="space-y-6">
                <h3 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em] flex items-center space-x-2">
                    <i class="fas fa-info-circle"></i>
                    <span>Qo'shimcha ma'lumotlar</span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Bo'lim (Kategoriya)</label>
                        <select name="category" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                            <option value="Yangilik">Yangilik</option>
                            <option value="Tadbir">Tadbir</option>
                            <option value="E'lon">E'lon</option>
                            <option value="Yutuq">Yutuq</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Holati (Status)</label>
                        <select name="status" class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium">
                            <option value="published">Nashr etilgan</option>
                            <option value="draft">Qoralama</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1">Rasm URL</label>
                        <input type="text" name="image" required class="w-full px-5 py-4 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all font-medium" placeholder="https://...">
                    </div>
                </div>
            </section>

            <div class="pt-10 border-t border-gray-50">
                <button type="submit" class="w-full md:w-auto px-12 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-black text-xs uppercase tracking-widest transition-all shadow-xl shadow-blue-900/20">
                    Yangilikni qo'shish
                </button>
            </div>
        </form>
    </div>
</div>
