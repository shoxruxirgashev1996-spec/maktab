<div class="bg-white rounded-[32px] overflow-hidden shadow-sm border border-gray-100">
    <div class="px-8 py-6 border-b border-gray-50 flex justify-between items-center">
        <h3 class="text-xl font-black text-gray-900 uppercase">Yangiliklar ro'yxati</h3>
        <a href="/admin/news/create" class="px-6 py-3 bg-[#003366] text-white rounded-xl text-xs font-black uppercase tracking-widest hover:bg-blue-800 transition-all flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>Yangi qo'shish</span>
        </a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-gray-50 text-[10px] font-black text-gray-400 uppercase tracking-widest">
                <tr>
                    <th class="px-8 py-4">Sarlavha</th>
                    <th class="px-8 py-4">Sana</th>
                    <th class="px-8 py-4">Kategoriya</th>
                    <th class="px-8 py-4 text-right">Amallar</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                <% news.forEach(item => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-8 py-5">
                        <div class="flex items-center space-x-4">
                            <img src="<%= item.image %>" class="w-12 h-12 rounded-xl object-cover" alt="">
                            <span class="text-sm font-bold text-gray-900 line-clamp-1"><%= item.title.uz || item.title %></span>
                        </div>
                    </td>
                    <td class="px-8 py-5 text-xs font-bold text-gray-400 uppercase">
                        <%= new Date(item.date).toLocaleDateString() %>
                    </td>
                    <td class="px-8 py-5">
                        <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] font-black uppercase"><%= item.category %></span>
                    </td>
                    <td class="px-8 py-5 text-right space-x-2">
                        <a href="/admin/news/<%= item.id %>/edit" class="p-2 text-indigo-400 hover:text-indigo-600 transition-colors"><i class="fas fa-edit"></i></a>
                        <form action="/admin/news/<%= item.id %>?_method=DELETE" method="POST" class="inline-block">
                            <button type="submit" class="p-2 text-red-400 hover:text-red-600 transition-colors" onclick="return confirm('Ishonchingiz komilmi?')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (news.length === 0) { %>
                <tr>
                    <td colspan="4" class="px-8 py-20 text-center text-gray-400 font-bold uppercase tracking-widest">Hozircha yangiliklar yo'q</td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
