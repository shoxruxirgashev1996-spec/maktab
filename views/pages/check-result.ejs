<section class="min-h-[60vh] flex items-center justify-center p-8 bg-gray-50">
    <div class="max-w-4xl w-full">
        <% if (application) { %>
            <div class="bg-white rounded-[48px] p-12 shadow-2xl shadow-blue-900/10 border border-gray-100 text-center">
                <div class="w-24 h-24 bg-blue-50 text-[#003366] rounded-[32px] flex items-center justify-center mx-auto mb-10 shadow-xl shadow-blue-900/5 transform rotate-6">
                    <i class="fas fa-search text-3xl"></i>
                </div>
                <h1 class="text-4xl font-black text-gray-900 uppercase tracking-tighter mb-4">Natijani tekshirish</h1>
                <p class="text-gray-400 font-bold uppercase text-[10px] tracking-[0.2em] mb-12">Ariza holati ma'lumotlari</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left mb-12">
                    <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
                        <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">F.I.SH</div>
                        <div class="text-lg font-black text-[#003366] uppercase"><%= application.first_name %> <%= application.last_name %></div>
                    </div>
                    <div class="p-8 bg-gray-50 rounded-3xl border border-gray-100">
                        <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Holati</div>
                        <div class="flex items-center space-x-3">
                            <% if (application.status === 'pending') { %>
                                <span class="w-3 h-3 bg-yellow-400 rounded-full animate-pulse"></span>
                                <span class="text-lg font-black text-yellow-600 uppercase">Ko'rib chiqilmoqda</span>
                            <% } else if (application.status === 'accepted') { %>
                                <span class="w-3 h-3 bg-emerald-500 rounded-full"></span>
                                <span class="text-lg font-black text-emerald-600 uppercase">Qabul qilindi</span>
                            <% } else { %>
                                <span class="w-3 h-3 bg-red-500 rounded-full"></span>
                                <span class="text-lg font-black text-red-600 uppercase">Rad etildi</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="p-8 bg-blue-50 border border-blue-100 rounded-3xl text-blue-600 font-bold text-sm leading-relaxed mb-12">
                    <i class="fas fa-info-circle mr-2"></i>
                    Sizning arizangiz muvaffaqiyatli ro'yxatdan o'tgan. Iltimos, imtihon sanasini jadvaldan ko'rib chiqing.
                </div>

                <a href="/" class="inline-flex items-center space-x-3 px-10 py-5 bg-[#003366] text-white rounded-[24px] font-black uppercase tracking-[0.2em] shadow-xl hover:bg-blue-800 transition-all transform hover:-translate-y-1">
                    <i class="fas fa-home"></i>
                    <span>Asosiy sahifa</span>
                </a>
            </div>
        <% } else { %>
            <div class="text-center">
                <h1 class="text-2xl font-black text-gray-400 uppercase">Ma'lumot topilmadi</h1>
            </div>
        <% } %>
    </div>
</section>
