<section class="min-h-[60vh] flex items-center justify-center p-8">
    <div class="max-w-md w-full text-center">
        <div class="w-24 h-24 bg-red-50 text-red-500 rounded-3xl flex items-center justify-center mx-auto mb-10 shadow-xl shadow-red-900/5">
            <i class="fas fa-exclamation-triangle text-4xl"></i>
        </div>
        <h1 class="text-4xl font-black text-gray-900 uppercase tracking-tighter mb-4"><%= title %></h1>
        <p class="text-gray-500 font-bold uppercase text-[10px] tracking-[0.2em] mb-10 leading-relaxed">
            <%= error %>
        </p>
        <a href="/" class="inline-flex items-center space-x-3 px-10 py-5 bg-[#003366] text-white rounded-2xl font-black uppercase tracking-[0.2em] shadow-xl hover:bg-blue-800 transition-all transform hover:-translate-y-1">
            <i class="fas fa-arrow-left"></i>
            <span>Bosh sahifaga</span>
        </a>
    </div>
</section>
